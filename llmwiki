#!/bin/sh
# llmwiki 실행기 (macOS/Linux). 이 폴더의 .venv 파이썬으로 tools/llmwiki 를 실행한다.
DIR="$(cd "$(dirname "$0")" && pwd)"
PY="$DIR/.venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "가상환경(.venv)이 없습니다. 먼저 실행하세요: bash setup/setup_mac.sh" >&2
  exit 3
fi
export PYTHONPATH="$DIR/tools${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUTF8=1
export LLMWIKI_ROOT="${LLMWIKI_ROOT:-$DIR}"
exec "$PY" -m llmwiki "$@"
